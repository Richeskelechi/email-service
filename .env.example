NODE_ENV=local
# NODE_ENV=staging   → Resend (needs RESEND_API_KEY)
# NODE_ENV=production → your SMTP (needs SMTP_HOST, optional SMTP_USER/SMTP_PASS)

DATABASE_URL="postgresql://postgres@localhost:5432/my_email?schema=public"

PORT=3000
DEV_API_KEY="dev_local_secret_change_me"

# --- local (Mailpit) defaults when NODE_ENV=local ---
# SMTP_HOST="127.0.0.1"
# SMTP_PORT=1025

# --- staging (Resend) when NODE_ENV=staging ---
# RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM_DEFAULT must be a verified Resend sender/domain
# Optional overrides:
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=465
# SMTP_SECURE="true"

# --- production (your MTA) when NODE_ENV=production ---
# SMTP_HOST="127.0.0.1"
# SMTP_PORT=587
# SMTP_STARTTLS="true"
# SMTP_USER=""
# SMTP_PASS=""

MAIL_FROM_DEFAULT="noreply@example.com"

WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_FANOUT_CHUNK=100
BULK_MAX_RECIPIENTS=1000
ORG_RATE_LIMIT_PER_MINUTE=120

APP_BASE_URL="http://127.0.0.1:3000"
PASSWORD_SETUP_TOKEN_TTL_HOURS=48
SESSION_TTL_DAYS=30
